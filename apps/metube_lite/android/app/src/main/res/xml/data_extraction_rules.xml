<?xml version="1.0" encoding="utf-8"?>
<!--
  أندرويد 12+ — `dataExtractionRules`. نفس سبب `backup_rules.xml`
  المجاور، بمجالين: النسخ السحابي ونقل الجهاز-إلى-جهاز.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
