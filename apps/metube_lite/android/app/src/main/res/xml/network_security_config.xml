<?xml version="1.0" encoding="utf-8"?>
<!--
  Lite restricts cleartext traffic to private hosts; Super allows it broadly.

  The documented trap (SERVER-API.md §6.2): `<domain>` **does not support
  CIDR**. It is ignored silently, so "all of 192.168.0.0/16" cannot be
  expressed and the hosts have to be listed one by one.

  Why this costs Lite nothing: its only network layer is Dio (add, poll,
  pull, delete), which runs on Dart's own HttpClient and is not governed by
  this setting at all — and **Lite never streams from the server** (its
  library is entirely local; streaming is Super's feature). This config is a
  seatbelt for Java-side libraries (ExoPlayer/OkHttp) should one ever be
  pointed at a local host.

  **Add your own server's address here** if you need it: the line below is an
  example (`192.168.1.10`), not a real address.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.10</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
