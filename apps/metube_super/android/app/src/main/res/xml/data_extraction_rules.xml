<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: `dataExtractionRules`. Same reason as the neighbouring
  `backup_rules.xml`, across both of its scopes — cloud backup and
  device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
