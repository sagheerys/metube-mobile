<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's automatic backup, Android 11 and below: `fullBackupContent`.

  **A latent defect.** The manifest never mentioned `allowBackup`, and the
  default is **on**. So Google was copying every `SharedPreferences` file to
  the user's account — **including the secure-storage file**,
  `FlutterSecureStorage.xml`. Its contents are encrypted with a key that
  lives in **this device's** Keystore and does not travel with it, so the
  file arrives on the new phone without its key and reading a secret (the
  server password) throws on first launch instead of returning "nothing".

  The exclusion below fixes that: ordinary data is backed up, secrets are
  not. Losing them is intended — the user re-enters the password once, and
  it never enters our own backups either (SERVER-API.md §5.4).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
</full-backup-content>
