<?xml version="1.0" encoding="utf-8"?>
<!--
  نسخ أندرويد التلقائي (أندرويد 11 وما دونه) — `fullBackupContent`.

  **عطل كامن كُشف 2026-09-04:** الـmanifest لم يذكر `allowBackup`،
  والافتراضي **مفعَّل**. فكانت جوجل تنسخ كل `SharedPreferences` إلى حساب
  المستخدم — **ومنها ملف التخزين الآمن** `FlutterSecureStorage.xml`.
  محتواه مشفَّر بمفتاح يعيش في Keystore **هذا الجهاز** ولا يُنسخ معه،
  فيصل الملف إلى الهاتف الجديد بلا مفتاحه ⇒ قراءة الأسرار (كلمة مرور
  السيرفر) ترمي عند أول إقلاع بدل أن تعود «لا شيء».

  الاستثناء أدناه يحل هذا: البيانات العادية تُنسخ، والأسرار لا. وفقدها
  مقصود — المستخدم يعيد إدخال كلمة المرور مرة واحدة، وهي لا تدخل نسخنا
  الاحتياطية أصلاً (§5.4).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
</full-backup-content>
