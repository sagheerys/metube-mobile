# Normalise line endings to LF, except Windows scripts.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary

# Test fixtures are captured server responses, not source. Without this,
# GitHub's language bar reports the project as mostly HTML because of a
# single 10KB SoundCloud page saved as a fixture.
packages/mt_core/test/fixtures/** linguist-vendored

# Generated by `flutter gen-l10n` from the .arb files; not hand-written.
packages/mt_ui/lib/src/l10n/generated/** linguist-generated
