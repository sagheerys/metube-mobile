# ===== Build outputs — never in the repository =====
# Lesson from the previous generation of this project: a 62MB APK and video
# files had been committed into git.
*.apk
*.aab
*.zip
*.mp4
*.metube_backup*.json
metube_*_backup.json

# ===== Secrets =====
.env
.env.*
*.secret

# ===== IDE / OS =====
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs and temporaries =====
*.log
logs/
tmp/

# Signing keys — never in git. Copies live on the two backup drives.
keys/

# Backup passphrases: the key next to the backup means the data is exposed.
*_backup_key.txt

# ===== Agent tooling — local to the maintainer's machine =====
# Third-party skill content (sources and hashes recorded in skills-lock.json)
# is not republished from here; restore it from its own sources when needed.
.claude/
skills-lock.json

# ── Local-only, archived out of the public repo (2026-09-09) ──
# These stay on the maintainer's disk and on the backup drive. They are not
# useful to anyone cloning the project, and some carry local paths.
CLAUDE.md
RELEASE_NOTES.md
backup.cmd
checkpoint.cmd
restore.cmd
tool/auto-checkpoint.ps1
tool/backup.ps1
tool/build-apk.ps1
